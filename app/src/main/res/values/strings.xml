    <!-- ============ 关于 ============ -->
    <string name="about_title">关于 App</string>
    <string name="about_version_format">版本 %1$s</string>
    <string name="about_intro_title">产品简介</string>
    <string name="about_intro">极简记账是一个以快速记录为入口、以周/月/年消费分析为核心价值、以月预算为控制手段的个人记账 App。</string>
    <string name="about_loop">记 → 看 → 懂 → 控</string>
    <string name="about_offline">离线可用：核心记账与统计不依赖网络，也不申请任何网络权限。</string>
    <string name="about_agreement">用户协议</string>
    <string name="about_privacy">隐私说明</string>
    <string name="about_agreement_content">本应用按「现状」提供个人记账能力，统计结果仅基于你在本机录入的数据，不构成任何财务、税务或投资建议。清空本地数据后不可恢复，请自行留意。</string>
    <string name="about_privacy_content">本应用不收集、不上传任何个人信息。全部账单、分类、预算与设置数据仅保存在本机应用私有目录的 SQLite 数据库中，V1 不含账号体系、云同步与网络权限。</string>

