<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/importRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_navigate_up"
        app:navigationIcon="@drawable/ic_arrow_left"
        app:title="@string/import_title" />

    <!-- 顶部：说明 + 选择文件 + 预览合计（合计在解析后才出现） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/page_margin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_desc"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickFileButton"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/import_pick"
            app:icon="@drawable/ic_import"
            app:iconTint="@color/text_on_primary" />

        <TextView
            android:id="@+id/importSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/importHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/import_preview_hint"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:visibility="gone" />

    </LinearLayout>

    <View
        style="@style/AppDivider"
        android:layout_marginTop="@dimen/spacing_md" />

    <!-- 中部：逐行预览列表，未选择文件时显示占位提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/importPreviewList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_lg"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/importEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl"
            android:text="@string/import_preview_placeholder"
            android:textAppearance="@style/TextAppearance.App.Secondary" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmImportButton"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/page_margin"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:enabled="false"
        android:text="@string/import_pick"
        android:visibility="gone"
        app:icon="@drawable/ic_check"
        app:iconTint="@color/text_on_primary" />

</LinearLayout>
