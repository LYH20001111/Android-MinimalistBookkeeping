<?xml version="1.0" encoding="utf-8"?>
<!--
  V5 账单确认页：扫描账单 / AI 智能记账产出的草稿在此逐字段确认、修改后落库。
  识别结果不能直接入账（基线第 7、16 章），字段结构与「记一笔」保持同构，
  但只有支出 / 收入两种类型，且不含转账与删除。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_navigate_up"
        app:navigationIcon="@drawable/ic_arrow_left"
        app:title="@string/confirm_title" />

    <ScrollView
        android:id="@+id/confirmScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- 识别来源提示（基线第 42 章：轻提示，不做复杂弹窗） -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/confirmBanner"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/confirmBannerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_sparkle"
                    android:drawablePadding="@dimen/spacing_sm"
                    android:drawableTint="@color/primary"
                    android:text="@string/confirm_banner_ai"
                    android:textAppearance="@style/TextAppearance.App.Secondary"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 支出 / 收入 切换（智能记账不支持转账） -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/typeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeExpense"
                    style="@style/Widget.App.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/edit_type_expense" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typeIncome"
                    style="@style/Widget.App.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/edit_type_income" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- 金额 -->
            <TextView
                android:id="@+id/amountPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/amount_zero"
                android:textAppearance="@style/TextAppearance.App.Display" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amountLayout"
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:hint="@string/edit_amount_hint"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/amountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textSize="@dimen/font_body" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- 分类 -->
            <TextView
                android:id="@+id/categoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/edit_category_title"
                android:textAppearance="@style/TextAppearance.App.SectionTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/categoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/edit_category_empty"
                android:textAppearance="@style/TextAppearance.App.Secondary"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <!-- 账户：草稿无账户概念，默认落到首个未归档账户 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/accountLayout"
                style="@style/Widget.App.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:hint="@string/edit_account_title">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/accountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="@dimen/font_body" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/accountEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/edit_account_empty"
                android:textAppearance="@style/TextAppearance.App.Secondary"
                android:textColor="@color/danger"
                android:visibility="gone" />

            <!-- 日期与时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateButton"
                    style="@style/Widget.App.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_pick_date"
                    android:gravity="start|center_vertical"
                    app:icon="@drawable/ic_calendar"
                    app:iconSize="@dimen/icon_size_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timeButton"
                    style="@style/Widget.App.Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    app:icon="@drawable/ic_time"
                    app:iconSize="@dimen/icon_size_sm" />

            </LinearLayout>

            <!-- 备注：识别出的商家折入此处一起确认 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/noteLayout"
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:hint="@string/confirm_note_hint"
                app:counterEnabled="true"
                app:counterMaxLength="@integer/note_max_length">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="@integer/note_max_length"
                    android:maxLines="1"
                    android:textSize="@dimen/font_body" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/confirm_action_book" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rescanButton"
                style="@style/Widget.App.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/confirm_action_rescan" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
