<?xml version="1.0" encoding="utf-8"?>
<!-- V2.1 分类选择器网格项：Emoji 圆形图标 + 名称 + 选中 ✓ 徽标。
     选中态由 bg_category_selectable（主色描边 + 弱化底）与 ✓ 共同表达，不单靠颜色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_selectable"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_sm">

    <FrameLayout
        android:layout_width="@dimen/category_icon_size"
        android:layout_height="@dimen/category_icon_size"
        android:background="@drawable/bg_category_circle">

        <TextView
            android:id="@+id/pickerIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_category_icon"
            android:gravity="center"
            android:textSize="@dimen/font_emoji" />

        <TextView
            android:id="@+id/pickerCheck"
            android:layout_width="@dimen/picker_check_size"
            android:layout_height="@dimen/picker_check_size"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_xxs"
            android:background="@drawable/bg_picker_check"
            android:gravity="center"
            android:text="@string/picker_check_mark"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/font_caption"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/pickerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.Caption" />

</LinearLayout>
