<?xml version="1.0" encoding="utf-8"?>
<!-- V4.0 退款记录页：从编辑账单页右上角菜单进入，展示一笔账单的全部退款流水（最新在前） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refundRecordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_navigate_up"
            app:navigationIcon="@drawable/ic_arrow_left"
            app:title="@string/refund_record_title" />

        <!-- 汇总行由观察到的流水实时重算，不依赖账单行上的缓存列 -->
        <TextView
            android:id="@+id/refundSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_tertiary"
            tools:text="已退 ¥10.00 · 待退 ¥20.00 · 账单原额 ¥100.00" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/refundRecordList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/spacing_xxl" />

    </LinearLayout>

    <TextView
        android:id="@+id/refundRecordEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/refund_record_empty"
        android:textAppearance="@style/TextAppearance.App.Secondary"
        android:visibility="gone" />

</FrameLayout>
