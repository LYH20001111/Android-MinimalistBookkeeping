<?xml version="1.0" encoding="utf-8"?>
<!--
  记一笔页「智能记账」自绘弹层（TransactionEditActivity.showSmartMenuPopup 使用，V5）。
  与 popup_transaction_edit_menu 同款：MaterialCardView 提供圆角 + 描边 + 阴影，
  PopupWindow 侧配透明背景；每行标题下带一句副标题说明用途（基线第 40 章推荐文案）。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/spacing_xs"
    app:strokeColor="@color/divider"
    app:strokeWidth="@dimen/stroke_width">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <LinearLayout
            android:id="@+id/action_scan_bill"
            style="@style/AppPopupMenuItem"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_camera"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_menu_scan_title"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_menu_scan_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_ai_bookkeeping"
            style="@style/AppPopupMenuItem"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_menu_ai_title"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_menu_ai_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
