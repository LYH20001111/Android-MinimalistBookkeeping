<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_selectable"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_sm">

    <FrameLayout
        android:layout_width="@dimen/category_icon_size"
        android:layout_height="@dimen/category_icon_size"
        android:background="@drawable/bg_category_circle">

        <TextView
            android:id="@+id/gridIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_category_icon"
            android:gravity="center"
            android:textSize="@dimen/font_emoji" />

    </FrameLayout>

    <TextView
        android:id="@+id/gridName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.Caption" />

</LinearLayout>
