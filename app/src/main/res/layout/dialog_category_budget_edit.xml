<?xml version="1.0" encoding="utf-8"?>
<!-- 分类预算编辑弹窗（V2 Phase 6）：清空金额后保存等价于删除该分类的当月预算。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xl"
    android:paddingTop="@dimen/spacing_xl"
    android:paddingEnd="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_lg">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/amountLayout"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/category_budget_edit_hint"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/amountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textSize="@dimen/font_body" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
