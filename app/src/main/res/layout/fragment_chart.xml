<?xml version="1.0" encoding="utf-8"?>
<!-- V1.1 目标 B：周期切换与周期导航移出滚动区，空周期时依然可见，只有下方数据区进入空状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chartRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/spacing_lg"
    android:paddingEnd="@dimen/page_margin">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chart_title"
        android:textAppearance="@style/TextAppearance.App.PageTitle" />

    <!-- 周期切换：周 / 月 / 年 -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/periodGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/periodWeek"
            style="@style/Widget.App.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_period_week" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/periodMonth"
            style="@style/Widget.App.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_period_month" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/periodYear"
            style="@style/Widget.App.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/chart_period_year" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 周期导航：‹  Week 5 / 08.30-09.05 · 共 6 笔  ›，中间区域可点击打开周期选择器（V1.1 目标 C） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevButton"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_previous_period"
            app:icon="@drawable/ic_chevron_left" />

        <LinearLayout
            android:id="@+id/periodCenter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/cd_period_center"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/periodLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.SectionTitle" />

            <TextView
                android:id="@+id/periodCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Caption" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_next_period"
            app:icon="@drawable/ic_chevron_right" />

    </LinearLayout>

    <!-- 数据区：图表卡片可滚动，空状态覆盖其上；两者都位于周期导航下方，导航始终可见 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/chartScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_xxl">

                <!-- 第一层核心数字 + 第二层环比 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/chart_income"
                                    android:textAppearance="@style/TextAppearance.App.Caption" />

                                <TextView
                                    android:id="@+id/chartIncomeValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:maxLines="1"
                                    android:text="@string/amount_zero"
                                    android:textAppearance="@style/TextAppearance.App.SectionTitle"
                                    app:autoSizeMaxTextSize="@dimen/font_section_title"
                                    app:autoSizeMinTextSize="@dimen/font_caption"
                                    app:autoSizeStepGranularity="@dimen/autosize_step_granularity"
                                    app:autoSizeTextType="uniform" />

                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/divider_height"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:layout_marginEnd="@dimen/spacing_md"
                                android:background="@color/divider" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/chart_expense"
                                    android:textAppearance="@style/TextAppearance.App.Caption" />

                                <TextView
                                    android:id="@+id/chartExpenseValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:maxLines="1"
                                    android:text="@string/amount_zero"
                                    android:textAppearance="@style/TextAppearance.App.SectionTitle"
                                    app:autoSizeMaxTextSize="@dimen/font_section_title"
                                    app:autoSizeMinTextSize="@dimen/font_caption"
                                    app:autoSizeStepGranularity="@dimen/autosize_step_granularity"
                                    app:autoSizeTextType="uniform" />

                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/divider_height"
                                android:layout_height="match_parent"
                                android:layout_marginStart="@dimen/spacing_md"
                                android:layout_marginEnd="@dimen/spacing_md"
                                android:background="@color/divider" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/chart_balance"
                                    android:textAppearance="@style/TextAppearance.App.Caption" />

                                <TextView
                                    android:id="@+id/chartBalanceValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:maxLines="1"
                                    android:text="@string/amount_zero"
                                    android:textAppearance="@style/TextAppearance.App.SectionTitle"
                                    app:autoSizeMaxTextSize="@dimen/font_section_title"
                                    app:autoSizeMinTextSize="@dimen/font_caption"
                                    app:autoSizeStepGranularity="@dimen/autosize_step_granularity"
                                    app:autoSizeTextType="uniform" />

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            style="@style/AppDivider"
                            android:layout_marginTop="@dimen/spacing_md" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chart_compare_label"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <TextView
                                android:id="@+id/chartChangeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:maxLines="1"
                                android:text="@string/placeholder_dash"
                                android:textAppearance="@style/TextAppearance.App.Secondary"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 第三层：趋势 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/trendCard"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_trend_title"
                            android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                        <com.skyanchor.bookkeeping.ui.widget.LineChartView
                            android:id="@+id/lineChart"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/chart_line_height"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:contentDescription="@string/cd_trend_chart" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 预算卡片：仅月视图出现 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/budgetCard"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/budget_card_title"
                                android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                            <TextView
                                android:id="@+id/budgetStatusChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill"
                                android:paddingStart="@dimen/spacing_md"
                                android:paddingTop="@dimen/spacing_xs"
                                android:paddingEnd="@dimen/spacing_md"
                                android:paddingBottom="@dimen/spacing_xs"
                                android:textAppearance="@style/TextAppearance.App.Caption"
                                android:visibility="gone" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/budgetSetGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/budgetAmountValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.App.Display" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/budgetProgress"
                                style="@style/Widget.App.Progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:max="@integer/percent_scale" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/budget_used_label"
                                        android:textAppearance="@style/TextAppearance.App.Caption" />

                                    <TextView
                                        android:id="@+id/budgetUsedValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/spacing_xs"
                                        android:maxLines="1"
                                        android:textAppearance="@style/TextAppearance.App.Secondary" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/budget_remaining_label"
                                        android:textAppearance="@style/TextAppearance.App.Caption" />

                                    <TextView
                                        android:id="@+id/budgetRemainingValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/spacing_xs"
                                        android:maxLines="1"
                                        android:textAppearance="@style/TextAppearance.App.Secondary" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/budget_usage_label"
                                        android:textAppearance="@style/TextAppearance.App.Caption" />

                                    <TextView
                                        android:id="@+id/budgetUsageValue"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/spacing_xs"
                                        android:maxLines="1"
                                        android:textAppearance="@style/TextAppearance.App.Secondary" />

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/budgetOverValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:textAppearance="@style/TextAppearance.App.Secondary"
                                android:textColor="@color/danger"
                                android:visibility="gone" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/budgetUnsetGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/budget_not_set_title"
                                android:textAppearance="@style/TextAppearance.App.Body" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/budget_not_set_subtitle"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/budgetSetButton"
                                style="@style/Widget.App.Button.Primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/action_go_setting" />

                        </LinearLayout>

                        <!-- V2 Phase 6：分类预算完成度（总预算之下的各分类使用率），仅已设置预算的分类出现 -->
                        <LinearLayout
                            android:id="@+id/budgetCategoryGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View
                                style="@style/AppDivider"
                                android:layout_marginTop="@dimen/spacing_md" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/budget_chart_category_title"
                                android:textAppearance="@style/TextAppearance.App.Caption" />

                            <!-- 各分类预算行由代码按 CategoryBudgetState 程序化 inflate，数量少不需 adapter -->
                            <LinearLayout
                                android:id="@+id/budgetCategoryList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:orientation="vertical" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 第四层：分类占比 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/categoryCard"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_category_title"
                            android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                        <com.skyanchor.bookkeeping.ui.widget.DonutChartView
                            android:id="@+id/donutChart"
                            android:layout_width="@dimen/chart_donut_size"
                            android:layout_height="@dimen/chart_donut_size"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:contentDescription="@string/cd_category_chart" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/categoryStatList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- V2：账户资金卡片（账户总余额 + 各账户当前余额），与周期无关，单独观察刷新 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/accountCard"
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/chart_account_title"
                            android:textAppearance="@style/TextAppearance.App.SectionTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:text="@string/chart_total_assets"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/totalAssetsValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:maxLines="1"
                            android:text="@string/amount_zero"
                            android:textAppearance="@style/TextAppearance.App.Display" />

                        <View
                            style="@style/AppDivider"
                            android:layout_marginTop="@dimen/spacing_md" />

                        <!-- 各账户余额行由代码按活跃账户程序化 inflate，账户数量少不需 adapter -->
                        <LinearLayout
                            android:id="@+id/accountBalanceList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 有账单但本周期没有支出时给出文字说明，不允许出现空白图表块 -->
                <TextView
                    android:id="@+id/noExpenseHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:gravity="center"
                    android:text="@string/chart_trend_empty"
                    android:textAppearance="@style/TextAppearance.App.Secondary"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- 本周期无任何账单：只让数据区进入空状态，周期切换与导航仍保留 -->
        <include
            android:id="@+id/chartEmpty"
            layout="@layout/view_chart_empty_state" />

    </FrameLayout>

</LinearLayout>
