<?xml version="1.0" encoding="utf-8"?>
<!--
  V4.0 退款表单（BottomSheetDialog 内容）。
  额度提示取自账单三数（原额 / 已退 / 待退），到账状态默认「待到账」——
  只有确认钱已经回来才选「已到账」，此时才冲减支出统计与账户余额。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refundSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/spacing_lg"
    android:paddingEnd="@dimen/page_margin">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/refund_sheet_title"
        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

    <TextView
        android:id="@+id/refundQuota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxs"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_tertiary"
        tools:text="账单 ¥100.00 · 最多可退 ¥70.00" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/refundAmountLayout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/refund_sheet_amount_hint"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/refundAmountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:paddingEnd="96dp"
                android:textSize="@dimen/font_body" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refundAllButton"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_xxs"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_xxs"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/refund_sheet_full_refund"
            android:textColor="@color/primary"
            android:textSize="@dimen/font_caption"
            app:cornerRadius="@dimen/radius_sm"
            app:strokeColor="@color/primary" />

    </FrameLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/refundReasonLayout"
        style="@style/Widget.App.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/refund_sheet_reason_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/refundReasonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="100"
            android:maxLines="1"
            android:textSize="@dimen/font_body" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/refundStateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/refund_sheet_state_title"
        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/refundStateGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/statePending"
            style="@style/Widget.App.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/refund_sheet_state_pending" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stateReceived"
            style="@style/Widget.App.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/refund_sheet_state_received" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/refundStateTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/refund_sheet_pending_tip"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/text_tertiary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/refundSubmit"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/refund_sheet_submit" />

</LinearLayout>
