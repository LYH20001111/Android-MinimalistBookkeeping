<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/page_margin"
    android:paddingBottom="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 色点与环形图分段同色，形成「图 ↔ 列表」的视觉对应 -->
        <View
            android:id="@+id/statDot"
            android:layout_width="@dimen/stat_dot_size"
            android:layout_height="@dimen/stat_dot_size"
            android:background="@drawable/bg_stat_dot" />

        <TextView
            android:id="@+id/statIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textSize="@dimen/font_emoji_small" />

        <TextView
            android:id="@+id/statName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/statAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <TextView
            android:id="@+id/statPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:gravity="end"
            android:maxLines="1"
            android:minWidth="@dimen/stat_percent_min_width"
            android:textAppearance="@style/TextAppearance.App.Secondary" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/statProgress"
        style="@style/Widget.App.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:max="@integer/percent_scale" />

</LinearLayout>
