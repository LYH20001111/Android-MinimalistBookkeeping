<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_item_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingEnd="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <!-- 账户类型 emoji 圆形底，复用分类行的圆形背景 Token -->
    <FrameLayout
        android:layout_width="@dimen/list_category_icon_size"
        android:layout_height="@dimen/list_category_icon_size"
        android:background="@drawable/bg_category_circle">

        <TextView
            android:id="@+id/rowIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_account_icon"
            android:gravity="center"
            android:textSize="@dimen/font_emoji" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第一行：账户名（左）+ 余额（右，可正可负用 danger 色，代码里着色） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/rowBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Body" />

        </LinearLayout>

        <!-- 第二行：类型标签 + 已归档徽标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <TextView
                android:id="@+id/rowArchived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:maxLines="1"
                android:text="@string/account_archived_badge"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/text_tertiary"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/rowUp"
        style="@style/Widget.App.RowAction"
        android:contentDescription="@string/category_move_up"
        android:src="@drawable/ic_arrow_up" />

    <ImageView
        android:id="@+id/rowDown"
        style="@style/Widget.App.RowAction"
        android:contentDescription="@string/category_move_down"
        android:src="@drawable/ic_arrow_down" />

    <ImageView
        android:id="@+id/rowEdit"
        style="@style/Widget.App.RowAction"
        android:contentDescription="@string/account_edit_title"
        android:src="@drawable/ic_edit" />

    <ImageView
        android:id="@+id/rowDelete"
        style="@style/Widget.App.RowAction.Danger"
        android:contentDescription="@string/action_delete"
        android:src="@drawable/ic_delete" />

</LinearLayout>
