<?xml version="1.0" encoding="utf-8"?>
<!-- V1.1 目标 B：图表空状态。周期切换与周期导航保持可见，只有数据区进入本空状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xxl"
    android:paddingTop="@dimen/spacing_xxl"
    android:paddingEnd="@dimen/spacing_xxl"
    android:paddingBottom="@dimen/spacing_xxl"
    android:visibility="gone">

    <ImageView
        android:id="@+id/emptyIcon"
        android:layout_width="@dimen/empty_icon_size"
        android:layout_height="@dimen/empty_icon_size"
        android:contentDescription="@string/cd_empty_state"
        android:src="@drawable/ic_empty"
        app:tint="@color/text_tertiary" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/chart_empty_title"
        android:textAppearance="@style/TextAppearance.App.SectionTitle" />

    <TextView
        android:id="@+id/emptySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center"
        android:text="@string/chart_empty_subtitle"
        android:textAppearance="@style/TextAppearance.App.Secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emptyAction"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/action_add_one"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/text_on_primary" />

    <!-- 空周期可能来自翻到远期，提供一键回到当前周/月/年 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/backToCurrentButton"
        style="@style/Widget.App.Button.Quiet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/chart_back_to_current" />

</LinearLayout>
