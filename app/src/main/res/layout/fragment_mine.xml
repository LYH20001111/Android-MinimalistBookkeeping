<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <!--
      「我的」页（V1 基线第 9 章，V3 增加云同步分组）：
      云同步为可选能力（基线第 34 章），开关与同步中心位于数据管理区域，
      视觉上不压过核心账务功能。
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/spacing_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_title"
            android:textAppearance="@style/TextAppearance.App.PageTitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuCategory"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuAccount"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuBudget"
                    layout="@layout/item_menu_row" />

                <!-- V3：云同步分组（基线第 34 章）。与其他菜单行同构；
                     开关在同步中心内（那里有完整的开启流程与状态展示）。 -->
                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuSync"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuSyncCenter"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuDevice"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuRecurring"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuAppearance"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuData"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuExport"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuImport"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuBackup"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuRestore"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuAbout"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
