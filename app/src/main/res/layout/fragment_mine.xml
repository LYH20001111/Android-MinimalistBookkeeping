<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <!--
      「我的」页（V1 基线第 9 章，V3 增加云同步分组）。
      功能入口按用途分为六个分组，每组一张卡片、卡片外配一个 GroupLabel 小节标题：
      账务管理 / 数据管理 / 同步与云服务 / 外观与个性化 / 账户与安全 / 关于。
      云同步为可选能力（基线第 34 章），开关在同步中心内，这里只做入口。
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/spacing_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_title"
            android:textAppearance="@style/TextAppearance.App.PageTitle" />

        <!-- ===== 账务管理 ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_accounting" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuCategory"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuAccount"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuRecurring"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuBudget"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 数据管理 ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_data" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuData"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuImport"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuExport"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuBackup"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuRestore"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 账本（V3.2：多账本与共享） ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_ledger" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuLedgers"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuInvitations"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 同步与云服务 ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_sync" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuSync"
                    layout="@layout/item_menu_row" />

                <View
                    style="@style/AppDivider"
                    android:layout_marginStart="@dimen/menu_divider_indent" />

                <include
                    android:id="@+id/menuSyncCenter"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 外观与个性化 ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_appearance" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuAppearance"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 账户与安全 ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_security" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuDevice"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 关于 ===== -->
        <TextView
            style="@style/AppGroupLabel"
            android:text="@string/mine_section_about" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentPadding="@dimen/spacing_none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/menuAbout"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
