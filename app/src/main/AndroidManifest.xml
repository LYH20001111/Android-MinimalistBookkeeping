<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        V1 基线「断网可用」：本地记账/图表/账户/预算/搜索全部能力不依赖网络，
        该验收项由「本地优先」架构保证。V3 起为可选云同步声明网络权限——
        服务器关机/断网时同步暂停、本地功能照常，语义不变。
        usesCleartextTraffic 仅服务家庭局域网直连自建服务器的开发场景，
        公网部署走 docker-compose 的 Caddy HTTPS 入口（见 server/README）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- V5：语音听写（AI 智能记账麦克风图标）录制音频，由系统语音识别服务转成文字填入输入框 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 包可见性：SpeechRecognizer 需要解析系统语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BookkeepingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MinimalistBookkeeping">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 以下页面全部只能由应用内部跳转，返回栈统一归属 MainActivity -->
        <activity
            android:name=".ui.record.TransactionEditActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <!-- V3.3：账单编辑记录（编辑账单页右上角三点菜单进入） -->
        <activity
            android:name=".ui.record.TransactionHistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- V5：智能记账（记一笔页右上角 ✨ 进入；识别失败不阻断手动记账） -->
        <activity
            android:name=".ui.smart.ScanBillActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.smart.AiBookkeepingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.smart.ConfirmBillActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.smart.AiSettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <!-- V4.0：账单退款记录（编辑账单页右上角菜单进入） -->
        <activity
            android:name=".ui.record.RefundRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.category.CategoryManageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.account.AccountManageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.account.AccountDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.budget.BudgetSettingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.recurring.RecurringManageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.AppearanceActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.DataManageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.importexport.DataExportActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.importexport.DataImportActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.importexport.BackupActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.importexport.RestoreActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- V3：认证与云同步页面（只能由应用内部跳转） -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.ledger.LedgerManageActivity" />
        <activity
            android:name=".ui.ledger.MemberManageActivity" />
        <activity
            android:name=".ui.ledger.InvitationActivity" />
        <activity
            android:name=".ui.sync.SyncCenterActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.sync.DeviceManageActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- V3.1：回收站 / 高级诊断 / 冲突历史（只能由应用内部跳转） -->
        <activity
            android:name=".ui.sync.RecycleBinActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.sync.SyncDiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.sync.ConflictHistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- V5：扫描账单拍照的临时文件共享（系统相机写入、本应用读取后即删） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>